PORT=3000
NODE_ENV=development

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Defina explicitamente a versão ativa da Graph API usada pela sua conta Meta.
WHATSAPP_GRAPH_VERSION=

# Segurança: deixe false enquanto estivermos validando a POC.
WHATSAPP_SEND_ENABLED=false
AUTO_ACCEPT_TEXT=Bora

# Próximas integrações
GOOGLE_MAPS_API_KEY=
ENGESP_API_BASE_URL=
ENGESP_API_TOKEN=
