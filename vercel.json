{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"Bot Guincho: frontend estatico + API serverless\"",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/health",
      "destination": "/api/worker/health?path=health"
    },
    {
      "source": "/api/health",
      "destination": "/api/worker/health?path=health"
    },
    {
      "source": "/api/runtime-version",
      "destination": "/api/worker/runtime-version?path=runtime-version"
    }
  ]
}
