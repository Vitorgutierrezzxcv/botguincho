{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"Bot Guincho: frontend estatico + API serverless + Vercel Sandbox\"",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
